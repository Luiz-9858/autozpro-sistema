generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// 📋 ENUMS
// ========================================

enum OrderStatus {
  PENDING      // Aguardando pagamento
  PAID         // Pago
  PROCESSING   // Em separação
  SHIPPED      // Enviado
  DELIVERED    // Entregue
  CANCELLED    // Cancelado
  REFUNDED     // Reembolsado
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  TRANSFER
}

// ========================================
// 👤 USUÁRIOS
// ========================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  reviews   Review[]

  @@map("users")
}

// ========================================
// 📦 PRODUTOS E CATEGORIAS
// ========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  salePrice   Float?
  stock       Int      @default(0)
  sku         String   @unique
  imageUrl    String?
  isActive    Boolean  @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reviews Review[]

  orderItems OrderItem[]
  vehicles   ProductVehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ========================================
// 🚗 VEÍCULOS E COMPATIBILIDADE
// ========================================

model Vehicle {
  id       String  @id @default(uuid())
  brand    String
  model    String
  year     Int
  version  String?
  engine   String?
  fuelType String?

  products ProductVehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([model])
  @@index([year])
  @@index([brand, model, year])

  @@map("vehicles")
}

model ProductVehicle {
  id        String @id @default(uuid())
  productId String
  vehicleId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, vehicleId])
  @@index([productId])
  @@index([vehicleId])

  @@map("product_vehicles")
}

// ========================================
// 🛒 PEDIDOS - CHECKOUT COMPLETO
// ========================================

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // Ex: AZ-2024-00001

  // 👤 Cliente (userId opcional: permite compra sem login)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  customerName     String
  customerEmail    String
  customerPhone    String
  customerDocument String // CPF ou CNPJ

  // 📍 Endereço de entrega
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String // UF: SP, RJ, MG...

  // 💰 Valores
  subtotal Decimal @db.Decimal(10, 2)           // Soma dos produtos
  shipping Decimal @db.Decimal(10, 2) @default(0) // Frete
  discount Decimal @db.Decimal(10, 2) @default(0) // Desconto/Cupom
  total    Decimal @db.Decimal(10, 2)           // Total final

  // 📋 Status e pagamento
  status        OrderStatus    @default(PENDING)
  paymentMethod PaymentMethod?

  // 🔗 Integrações externas
  paymentId    String? // ID do Mercado Pago/PagSeguro/Stripe
  trackingCode String? // Código de rastreio (Correios)

  // 📝 Observações
  notes String? // Observações do cliente

  // 📅 Ciclo de vida do pedido
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime? // Quando foi pago
  shippedAt   DateTime? // Quando foi enviado
  deliveredAt DateTime? // Quando foi entregue
  cancelledAt DateTime? // Quando foi cancelado

  // 📦 Itens do pedido
  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])

  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  // Referência ao produto (nullable se deletado)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // 📸 Snapshot do produto no momento da compra
  // (Garante histórico mesmo se produto for editado/deletado)
  productName  String
  productSku   String
  productImage String?

  // 💰 Valores
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2) // Preço unitário
  totalPrice Decimal @db.Decimal(10, 2) // quantity * unitPrice

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])

  @@map("order_items")
}

// ========================================
// ⭐ REVIEWS/AVALIAÇÕES
// ========================================
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      @default(5)
  title     String   @db.VarChar(100)
  comment   String   @db.Text
  verified  Boolean  @default(false)
  
  // Relacionamentos
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}
